# Video and Media binaries (ignore general video files)
*.mp4
*.webm
*.mov
*.avi
*.mkv
*.gif

# Track production slide videos, but ignore raw rendering caches
!presentation/assets/videos/*.mp4
!presentation/assets/videos/.gitkeep

# PDF documents (ignore heavy textbook PDFs, keep course sample problems tracked)
*.pdf
!Mechanical_Vibrations_Sample_Problems.pdf

# Manim rendering artifacts & caches
media/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# Python Virtual Environments
.venv/
venv/
env/
ENV/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS Generated Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes

# Node / Web artifacts
node_modules/
dist/
build/
.npm/
